FROM python:3.11-slim

RUN pip install --no-cache-dir "mlflow>=3.0" "psycopg2-binary>=2.9"

EXPOSE 5000

# --allowed-hosts: MLflow 3.x rejects requests whose Host header isn't in an
# allow-list (anti DNS-rebinding). The default list covers localhost/private
# IPs but not Docker Compose service names, so "mlflow" must be added
# explicitly or every client call fails with a 403 "Invalid Host header".
CMD ["sh", "-c", "mlflow server --backend-store-uri ${MLFLOW_BACKEND_STORE_URI} --default-artifact-root /mlartifacts --host 0.0.0.0 --port 5000 --allowed-hosts ${MLFLOW_ALLOWED_HOSTS:-mlflow,mlflow:5000,localhost,localhost:5000}"]
