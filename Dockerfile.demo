# Version simplifiée pour un déploiement gratuit en un seul service web
# (Render, etc.) : pas de Postgres ni de MongoDB externes -- MLflow tourne en
# mode "local" sur un fichier SQLite (pas de serveur MLflow séparé non plus,
# le dashboard lit directement le fichier), et les événements qualité /
# traçabilité vont dans un second fichier SQLite (src/events_sqlite.py) au
# lieu de MongoDB. Voir le README, section "Version simplifiée en ligne",
# pour le compromis assumé (persistance non garantie entre redéploiements
# sur un hébergeur gratuit -- le conteneur se re-seed avec un run réel à
# chaque démarrage).
FROM python:3.11-slim

WORKDIR /app

ENV GIT_PYTHON_REFRESH=quiet
ENV PERSISTENCE_BACKEND=sqlite
# Tout ce qui doit être écrit à l'exécution va dans /tmp : certains
# hébergeurs gratuits (observé sur Render) montent le système de fichiers du
# conteneur en LECTURE SEULE en dehors de /tmp. Écrire dans ./data (sous
# /app) y échoue silencieusement (le process continue, mais l'entraînement
# de démarrage plante) -- reproduit et confirmé en local avec
# `docker run --read-only --tmpfs /tmp`. /tmp reste inscriptible sur
# quasiment tous les runtimes de conteneurs, y compris avec un rootfs
# en lecture seule.
ENV MLFLOW_TRACKING_URI=sqlite:////tmp/data/mlflow.db
ENV MLFLOW_ARTIFACT_ROOT=/tmp/data/mlartifacts
ENV SQLITE_EVENTS_PATH=/tmp/data/events.db
ENV SEED_LOG_PATH=/tmp/data/seed_training.log

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
COPY data/fallback_weather.csv data/fallback_weather.csv

EXPOSE 8501

# mkdir au runtime (pas au build) : /tmp est un tmpfs vide à chaque
# démarrage de conteneur, ce que "RUN mkdir" au build ne couvre pas.
CMD ["sh", "-c", "mkdir -p /tmp/data && python3 src/train.py --start 2026-07-01 --end 2026-09-17 > ${SEED_LOG_PATH} 2>&1; streamlit run src/dashboard.py --server.port=${PORT:-8501} --server.address=0.0.0.0"]
